  {
   "sha": "e7b3a219617472cf78880ac424714e52c932db61",
   "node_id": "C_kwDOKy0w_toAKGU3YjNhMjE5NjE3NDcyY2Y3ODg4MGFjNDI0NzE0ZTUyYzkzMmRiNjE",
   "commit": {
    "author": {
     "name": "Tejun Heo",
     "email": "tj@kernel.org",
     "date": "2026-10-15T19:24:14Z"
    },
    "committer": {
     "name": "Tejun Heo",
     "email": "tj@kernel.org",
     "date": "2026-10-15T19:24:14Z"
    },
    "message": "ci: Package scx_arena with its workspace dependencies\n\nThe scx_arena package check packages scx_arena alone, so cargo looks up its\nscx_cargo, scx_stats and scx_utils dependencies on crates.io. A release PR\nbumps every crate before any of them is published, and the check fails there\nbecause the bumped scx_utils is not on crates.io yet.\n\nPackage the workspace dependencies in the same run. cargo then uses the\nlocal versions, and the check passes before the release is published.",
    "tree": {
     "sha": "632048e259ac725d742014cc112cd6071719bc62",
     "url": "https://api.github.com/repos/sched-ext/scx/git/trees/632048e259ac725d742014cc112cd6071719bc62"
    },
