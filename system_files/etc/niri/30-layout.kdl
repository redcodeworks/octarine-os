// Layout and screenshots: niri's defaults written out, with a few changes marked below (centered focus on overflow, a centered single column, a
// 1/4 and 3/4 preset, a third-width default column, a drop shadow behind windows, 32 pixel outer struts, left tab bars, no startup hotkey pop-up).
// The colors are niri's own on purpose: the image is theme neutral.
// Reference: https://niri-wm.github.io/niri/Configuration:-Layout
layout {
    gaps 16
    // Center the focused column when it does not fit next to the previous one; a single column is always centered.
    center-focused-column "on-overflow"
    always-center-single-column true

    // Widths that Mod+R cycles through.
    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.75
    }

    // New windows start a third of the screen wide.
    default-column-width { proportion 0.33333; }

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    // The border stays off; the focus ring is used instead.
    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    // Drop shadows, drawn behind the window so translucent and rounded windows show no artifacts.
    shadow {
        on
        draw-behind-window true
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    // Outer gaps: a 32 pixel strip around the usable area (in addition to the gaps between windows).
    struts {
        left 32
        right 32
        top 32
        bottom 32
    }

    // The tab bar of a tabbed column: a wide bar on the left, hidden when the column has a single tab.
    tab-indicator {
        width 8
        gap 8
        length total-proportion=1.0
        position "left"
        place-within-column
        hide-when-single-tab
    }

    // The marker that shows where a dragged window will land (niri's default color).
    insert-hint {
        color "#ffc87f80"
    }
}

// No "Important Hotkeys" pop-up at startup (Mod+Shift+/ still shows it).
hotkey-overlay {
    skip-at-startup
}

// Animations: niri's defaults (see https://niri-wm.github.io/niri/Configuration:-Animations to change or turn them off).
animations {
}

// Screenshots go here (strftime format; a leading ~ is your home directory).
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
