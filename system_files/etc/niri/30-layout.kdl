// Layout and screenshots: niri's defaults, written out so they are easy to change.
// Reference: https://niri-wm.github.io/niri/Configuration:-Layout
layout {
    gaps 16
    center-focused-column "never"

    // Widths that Mod+R cycles through.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    // The border stays off; the focus ring is used instead.
    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

// Screenshots go here (strftime format; a leading ~ is your home directory).
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
