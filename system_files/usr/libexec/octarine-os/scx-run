#!/usr/bin/env bash
# ExecStart of scx@.service: run the scheduler binary of the registry entry for this instance. The binary path and the flags come
# only from the root-owned registry; nothing from the caller's environment or from any user file is used.
#
# Two things happen around the binary:
#
# 1. The kernel config for libbpf. A scheduler whose BPF object has `.kconfig` externs (extern ... CONFIG_* __kconfig) makes libbpf
#    read the kernel config at load time, and libbpf (v1.7.0, bpf_object__read_kconfig_file) looks at exactly two places:
#    /boot/config-<uname -r> and /proc/config.gz. The image has neither (CONFIG_IKCONFIG is off, and the ostree /boot has no config
#    file), only /usr/lib/modules/<release>/config, so such a scheduler fails with "failed to open system Kconfig" and
#    "Failed to load BPF program: Invalid argument" (scx_lavd on the first real start). The binary therefore runs in its OWN mount
#    namespace (`unshare -m`: private, nothing leaks out) with a tmpfs over /boot that holds config-<release>, a read-only bind of
#    the image's config. The real /boot is never written. systemd's own mount properties (TemporaryFileSystem=/boot plus
#    BindReadOnlyPaths=) were tried on the real machine and die with 226/NAMESPACE, and specifiers (%v) are not expanded there.
#    Skipped (with a log line) when libbpf already finds a config, and with a warning when the image's file is missing.
#
# 2. Which exits may restart. The unit has Restart=on-failure for a scheduler that was active and then crashed. A start that never
#    became active (a load failure, or scx-verify judging it failed and systemd stopping it) must NOT restart by itself: every restart
#    would be one more counted failure, and the third writes the disabled-for-this-kernel marker. This script therefore stays as
#    the main process, waits for the scheduler and exits 75 (RestartPreventExitStatus=75 in the unit) unless scx-verify has left the
#    flag active-<INVOCATION_ID> in the run directory, which it does when the scheduler really was active. Tested on systemd 262:
#    a main process that exits 75 stops the restart even though ExecStartPost failed; exit 1 restarts.
set -uo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scx-lib.sh
. "${here}/scx-lib.sh"
name=${1-}
reg=$(scx_find_instance "${name}") || { scx_log "run: unknown scheduler instance"; exit 2; }
binary=$(scx_reg_get "${reg}" BINARY)
flags=$(scx_reg_get "${reg}" FLAGS)
[[ "${binary}" =~ ^/usr/bin/scx_[a-z0-9_]+$ && -x "${binary}" ]] || { scx_log "run ${name}: bad or missing binary '${binary}'"; exit 2; }

# test hook only (the units run with a clean environment): the registry value was validated above, a stub directory replaces /usr/bin
[[ -z "${OCTARINE_SCX_BIN_DIR-}" ]] || binary="${OCTARINE_SCX_BIN_DIR}/${binary##*/}"

unshare=${OCTARINE_SCX_UNSHARE:-/usr/bin/unshare}
sh_bin=${OCTARINE_SCX_SH:-/usr/bin/sh}
mount_bin=${OCTARINE_SCX_MOUNT:-/usr/bin/mount}
env_bin=${OCTARINE_SCX_ENV:-/usr/bin/env}
boot_dir=${OCTARINE_SCX_BOOT:-/boot}
proc_config=${OCTARINE_SCX_PROC_CONFIG:-/proc/config.gz}
modules_dir=${OCTARINE_SCX_MODULES:-/usr/lib/modules}
rel=$(scx_kernel)
image_config="${modules_dir}/${rel}/config"

# The script of the namespace: every value is a positional parameter, never interpolated; the binary and its flags follow them.
# shellcheck disable=SC2016  # single quotes on purpose: this text is the script of the inner shell
ns_script='mnt=$1; boot=$2; rel=$3; src=$4; envb=$5; shift 5
fail() { echo "octarine-scx: could not prepare the kernel config for libbpf: $1" >&2; exit 78; }
"$mnt" -t tmpfs tmpfs "$boot" || fail "tmpfs on $boot"
: > "$boot/config-$rel" || fail "creating $boot/config-$rel"
"$mnt" --bind -o ro "$src" "$boot/config-$rel" || fail "binding $src"
exec "$envb" -i PATH=/usr/bin:/usr/sbin LANG=C "$@"'

# shellcheck disable=SC2206  # the flags are a word list from the root-owned registry on purpose
words=("${binary}" ${flags})
if [[ -e "${boot_dir}/config-${rel}" || -e "${proc_config}" ]]; then
    cmd=("${env_bin}" -i PATH=/usr/bin:/usr/sbin LANG=C "${words[@]}")
elif [[ -r "${image_config}" ]]; then
    scx_log "run ${name}: no kernel config at ${boot_dir}/config-${rel} or ${proc_config} (libbpf's two places): giving the scheduler ${image_config} as ${boot_dir}/config-${rel} in a private mount namespace"
    cmd=("${unshare}" -m -- "${sh_bin}" -c "${ns_script}" octarine-scx "${mount_bin}" "${boot_dir}" "${rel}" "${image_config}" "${env_bin}" "${words[@]}")
else
    scx_log "run ${name}: WARNING: no kernel config at libbpf's places and none at ${image_config}; a scheduler that reads the kernel config will fail to load"
    cmd=("${env_bin}" -i PATH=/usr/bin:/usr/sbin LANG=C "${words[@]}")
fi

got_term=0
trap 'got_term=1' TERM INT HUP
"${cmd[@]}" &
pid=$!
while :; do
    wait "${pid}"
    rc=$?
    kill -0 "${pid}" 2> /dev/null || break
done

flag=""
[[ -z "${INVOCATION_ID-}" ]] || flag="${SCX_RUN_DIR}/active-${INVOCATION_ID}"
if [[ -n "${flag}" && -e "${flag}" ]]; then
    rm -f -- "${flag}"
    # it was active: a stop is a clean end, anything else keeps its status (Restart=on-failure restarts a crash)
    if ((got_term == 1)); then exit 0; fi
    scx_log "run ${name}: the scheduler exited with status ${rc} after having been active"
    exit "${rc}"
fi
scx_log "run ${name}: the scheduler exited (status ${rc}) without having been verified active: a failed start, not restarted automatically (exit 75)"
exit 75
