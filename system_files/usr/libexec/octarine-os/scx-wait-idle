#!/usr/bin/env bash
# ExecStartPre of scx@.service: wait (bounded) until no scheduler is loaded or still unregistering before this instance starts.
# The generated drop-ins already order the instances (Conflicts= plus After= on every other instance, so systemd finishes the stop
# of the old one first); this is the second line of defense for what ordering cannot see: a scheduler loaded by hand, a start with
# --job-mode=ignore-dependencies, or a process whose stop returned slightly before the kernel finished unregistering it. Without it
# the new scheduler fails with "another sched_ext scheduler is already running" (found 2026-11-14: GameMode end, lavd -> rusty).
#
# Always exits 0: when sched_ext is still busy after SCX_IDLE_SECONDS the start goes on and fails visibly as before (scx-run exits 75,
# scx-verify says busy and counts nothing); a real failure is never hidden here. Reads only the kernel's sysfs.
set -uo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scx-lib.sh
. "${here}/scx-lib.sh"
name=${1-}
scx_find_instance "${name}" > /dev/null || { scx_log "wait-idle: unknown scheduler instance"; exit 2; }
trap 'exit 143' TERM INT
state=${SCX_SYSFS}/state
busy() { local s; s=$(cat "${state}" 2> /dev/null) || return 1; [[ -n "${s}" && "${s}" != disabled ]]; }
busy || exit 0
scx_log "wait-idle ${name}: sched_ext is '$(cat "${state}" 2> /dev/null)' (ops '$(cat "${SCX_SYSFS}/root/ops" 2> /dev/null)'), waiting up to ${SCX_IDLE_SECONDS} s for it to become disabled"
deadline=$((SECONDS + SCX_IDLE_SECONDS))
while busy; do
    if ((SECONDS >= deadline)); then
        scx_log "wait-idle ${name}: still '$(cat "${state}" 2> /dev/null)' after ${SCX_IDLE_SECONDS} s; starting anyway (it fails visibly if sched_ext stays held)"
        exit 0
    fi
    sleep 0.2 &
    wait $!
done
scx_log "wait-idle ${name}: sched_ext is disabled, starting"
exit 0
