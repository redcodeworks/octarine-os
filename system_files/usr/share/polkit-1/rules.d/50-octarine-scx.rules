// Let the logged-in wheel user start, stop and restart the sched_ext scheduler units scx@<name>.service without a prompt, so the
// GameMode hooks and `ujust scheduler` can switch schedulers without a YubiKey touch. Nothing else is granted: not other units,
// not enable or disable (manage-unit-files), not other verbs. A request that lacks the `unit` or `verb` detail does not match.
// The unit files, the binaries and the flags are root-owned and fixed by the image, so this is a performance and availability
// risk for the session user, not code execution as root (see "Prebuilt binaries" and the scheduler notes in CLAUDE.md).
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (typeof unit !== "string" || typeof verb !== "string") {
        return polkit.Result.NOT_HANDLED;
    }
    if (!/^scx@[A-Za-z0-9_-]+\.service$/.test(unit)) {
        return polkit.Result.NOT_HANDLED;
    }
    if (verb !== "start" && verb !== "stop" && verb !== "restart") {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
