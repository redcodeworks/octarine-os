// Key bindings generated by `ujust niri-setup` (keybind wizard, EXPERIMENTAL): the HHKB layout, for keyboards without
// dedicated arrow, Page Up, Page Down, Home and End keys. Chosen modifiers: switching @SWITCH@, moving @MOVE@.
// It adds to the Standard part (40-binds-standard.kdl); no key combination is bound by both.
// The right-hand cluster: P up, Semicolon left, Slash down, Apostrophe right; K and L first and last column;
// U and J workspace up and down.

binds {
    // Switching: focus.
    @SWITCH@+Semicolon  { focus-column-left; }
    @SWITCH@+Slash      { focus-window-down; }
    @SWITCH@+P          { focus-window-up; }
    @SWITCH@+Apostrophe { focus-column-right; }
    @SWITCH@+K { focus-column-first; }
    @SWITCH@+L { focus-column-last; }
    @SWITCH@+J { focus-workspace-down; }
    @SWITCH@+U { focus-workspace-up; }

    // Moving.
    @MOVE@+Semicolon  { move-column-left; }
    @MOVE@+Slash      { move-window-down; }
    @MOVE@+P          { move-window-up; }
    @MOVE@+Apostrophe { move-column-right; }
    @MOVE@+K { move-column-to-first; }
    @MOVE@+L { move-column-to-last; }
    @MOVE@+J { move-column-to-workspace-down; }
    @MOVE@+U { move-column-to-workspace-up; }
}
