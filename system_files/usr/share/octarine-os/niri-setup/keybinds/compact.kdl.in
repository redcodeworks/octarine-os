// Key bindings generated by `ujust niri-setup` (keybind wizard, EXPERIMENTAL): the Compact keyboard part, vim-style keys.
// Chosen modifiers: switching @SWITCH@, moving @MOVE@. It adds to the Standard part (40-binds-standard.kdl); no key
// combination is bound by both.

binds {
    // Switching: focus (h j k l: left, down, up, right; u and i: workspace down and up, as in niri's defaults).
    @SWITCH@+H { focus-column-left; }
    @SWITCH@+J { focus-window-down; }
    @SWITCH@+K { focus-window-up; }
    @SWITCH@+L { focus-column-right; }
    @SWITCH@+U { focus-workspace-down; }
    @SWITCH@+I { focus-workspace-up; }

    // Moving.
    @MOVE@+H { move-column-left; }
    @MOVE@+J { move-window-down; }
    @MOVE@+K { move-window-up; }
    @MOVE@+L { move-column-right; }
    @MOVE@+U { move-column-to-workspace-down; }
    @MOVE@+I { move-column-to-workspace-up; }
}
