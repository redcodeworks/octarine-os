// Key bindings generated by `ujust niri-setup` (keybind wizard, EXPERIMENTAL): the Standard keyboard part.
// Chosen modifiers: switching @SWITCH@, moving @MOVE@, other actions @OTHER@.
// Based on niri's default key bindings (GPL-3.0-or-later), re-parameterized: the placeholders were replaced by your choice.
// Switching (focus) uses Left, Right, Up, Down, Page_Up, Page_Down, Home, End and 1-9; moving uses the same keys with the
// moving modifier; every other action uses its own letter or symbol keys with the "other" modifier, so the three roles
// never bind the same key combination. Not included (niri's defaults, 40-binds.kdl, have them): the monitor binds (focus
// or move to another monitor, move a workspace) and the Shift+wheel binds.
// Undo: put `include "40-binds.kdl"` back in config.kdl instead of the 40-binds-*.kdl lines, or restore a .bak-* file.

binds {
    // F1 shows the list of important hotkeys (niri's default is Mod+Shift+Slash).
    F1 { show-hotkey-overlay; }

    // Programs: the terminal (the app launcher is in 50-noctalia.kdl).
    @OTHER@+T hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // Volume, media and brightness keys, as in 40-binds.kdl.
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "command -v playerctl >/dev/null && exec playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "command -v playerctl >/dev/null && exec playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "command -v playerctl >/dev/null && exec playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "command -v playerctl >/dev/null && exec playerctl next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "command -v brightnessctl >/dev/null && exec brightnessctl --class=backlight set +10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "command -v brightnessctl >/dev/null && exec brightnessctl --class=backlight set 10%-"; }

    // Overview and closing windows.
    @OTHER@+O repeat=false { toggle-overview; }
    @OTHER@+Q repeat=false { close-window; }

    // Switching: focus.
    @SWITCH@+Left  { focus-column-left; }
    @SWITCH@+Down  { focus-window-down; }
    @SWITCH@+Up    { focus-window-up; }
    @SWITCH@+Right { focus-column-right; }
    @SWITCH@+Home { focus-column-first; }
    @SWITCH@+End  { focus-column-last; }
    @SWITCH@+Page_Down { focus-workspace-down; }
    @SWITCH@+Page_Up   { focus-workspace-up; }
    @SWITCH@+WheelScrollDown  cooldown-ms=150 { focus-workspace-down; }
    @SWITCH@+WheelScrollUp    cooldown-ms=150 { focus-workspace-up; }
    @SWITCH@+WheelScrollRight { focus-column-right; }
    @SWITCH@+WheelScrollLeft  { focus-column-left; }
    @SWITCH@+1 { focus-workspace 1; }
    @SWITCH@+2 { focus-workspace 2; }
    @SWITCH@+3 { focus-workspace 3; }
    @SWITCH@+4 { focus-workspace 4; }
    @SWITCH@+5 { focus-workspace 5; }
    @SWITCH@+6 { focus-workspace 6; }
    @SWITCH@+7 { focus-workspace 7; }
    @SWITCH@+8 { focus-workspace 8; }
    @SWITCH@+9 { focus-workspace 9; }

    // Moving: columns, windows, and columns to other workspaces.
    @MOVE@+Left  { move-column-left; }
    @MOVE@+Down  { move-window-down; }
    @MOVE@+Up    { move-window-up; }
    @MOVE@+Right { move-column-right; }
    @MOVE@+Home { move-column-to-first; }
    @MOVE@+End  { move-column-to-last; }
    @MOVE@+Page_Down { move-column-to-workspace-down; }
    @MOVE@+Page_Up   { move-column-to-workspace-up; }
    @MOVE@+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    @MOVE@+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }
    @MOVE@+WheelScrollRight { move-column-right; }
    @MOVE@+WheelScrollLeft  { move-column-left; }
    @MOVE@+1 { move-column-to-workspace 1; }
    @MOVE@+2 { move-column-to-workspace 2; }
    @MOVE@+3 { move-column-to-workspace 3; }
    @MOVE@+4 { move-column-to-workspace 4; }
    @MOVE@+5 { move-column-to-workspace 5; }
    @MOVE@+6 { move-column-to-workspace 6; }
    @MOVE@+7 { move-column-to-workspace 7; }
    @MOVE@+8 { move-column-to-workspace 8; }
    @MOVE@+9 { move-column-to-workspace 9; }

    // Other actions: windows in and out of columns, sizes, layout, session.
    @OTHER@+BracketLeft  { consume-or-expel-window-left; }
    @OTHER@+BracketRight { consume-or-expel-window-right; }
    @OTHER@+Comma  { consume-window-into-column; }
    @OTHER@+Period { expel-window-from-column; }
    @OTHER@+R { switch-preset-column-width; }
    @OTHER@+B { switch-preset-column-width-back; }
    @OTHER@+Y { switch-preset-window-height; }
    @OTHER@+X { reset-window-height; }
    @OTHER@+F { maximize-column; }
    @OTHER@+G { fullscreen-window; }
    @OTHER@+M { maximize-window-to-edges; }
    @OTHER@+N { expand-column-to-available-width; }
    @OTHER@+C { center-column; }
    @OTHER@+Z { center-visible-columns; }
    @OTHER@+Minus { set-column-width "-10%"; }
    @OTHER@+Equal { set-column-width "+10%"; }
    @OTHER@+A { set-window-height "-10%"; }
    @OTHER@+Backslash { set-window-height "+10%"; }
    @OTHER@+V { toggle-window-floating; }
    @OTHER@+Grave { switch-focus-between-floating-and-tiling; }
    @OTHER@+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Escape hatch for applications that inhibit shortcuts, then quit and power off monitors.
    @OTHER@+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    @OTHER@+E { quit; }
    Ctrl+Alt+Delete { quit; }
    @OTHER@+Backspace { power-off-monitors; }
}
