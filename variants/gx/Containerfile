# The gamer image of octarineOS (published as octarine-os-gx, see CLAUDE.md "gx image"): a base image plus the gaming packages (Steam,
# gamescope, MangoHud, GameMode, Sunshine and friends). The base is the published default image, or the NVIDIA or the dx image (BASE_IMAGE decides; the
# same layer builds octarine-os-gx, octarine-os-nvidia-gx and octarine-os-dx-gx). The same lineage and build strategy as the dx image (variants/dx):
#   silverblue-main:45   -> octarine-os:latest -> octarine-os-gx:latest
# The workflow resolves the base by DIGEST (and verifies its signature) and passes it in, so the build, the labels and the kernel check all
# talk about the same base:
#   BASE_IMAGE   ghcr.io/redcodeworks/octarine-os (or -nvidia, -dx)
#   BASE_TAG     latest (only names the channel in the labels; the digest decides)
#   BASE_DIGEST  sha256:... of that tag when the build started (empty only for a bare local `podman build`)
ARG BASE_IMAGE=ghcr.io/redcodeworks/octarine-os
ARG BASE_TAG=latest
ARG BASE_DIGEST=

# The gx binaries image, ghcr.io/redcodeworks/octarine-bins-gx: a signed FROM scratch image built by the octarine-bins repository (with its OWN key,
# keys/octarine-bins.pub). It carries the gaming package lists and their installer under /packages (required-fedora, required-negativo17 (Steam), required-copr (Sunshine,
# exact version), optional-fedora, install.sh) and, so far, no binary component (/COMPONENTS is empty). PINNED by digest, like octarine-bins in the default Containerfile:
# BINS_GX_DIGEST changes only through the weekly bump pull request (bump-run.sh, kind bins-gx), the gx build verifies the pinned digest on every build (dx-image.yml) and
# records it in the bins-gx label. BINS_GX_TAG is only for humans. The pin covers the lists and the installer (the package names, the exact Sunshine version); the
# other packages still float through dnf.
ARG BINS_GX_TAG=20261117-f1507cc
ARG BINS_GX_DIGEST=sha256:09dad5a13224c86c602d4f7fe40c2dc13a66deec4cc5d24d33e7b431e6a832f5
ARG BINS_GX_REF=ghcr.io/redcodeworks/octarine-bins-gx:${BINS_GX_TAG}@${BINS_GX_DIGEST}

FROM ${BINS_GX_REF} AS binsgx
# (the ARGs above sit before the first FROM: only ARGs declared there are visible in a FROM line)

FROM scratch AS ctx
COPY variants/gx/gx.sh /gx.sh
COPY build_files/final-cleanup.sh /final-cleanup.sh
COPY build_files/validate-repos.sh /validate-repos.sh
COPY build_files/install-binaries.sh /install-binaries.sh
# (no system_files tree: the packages bring their own units, rules and firewall services; add one here and a `cp -a` in gx.sh when a file is ever needed)

FROM ${BASE_IMAGE}:${BASE_TAG}${BASE_DIGEST:+@}${BASE_DIGEST}

# os-release IMAGE_VERSION of this build (set by the workflow), written by gx.sh
ARG IMAGE_VERSION
# os-release IMAGE_ID: octarine-os-gx, octarine-os-nvidia-gx when the base is the NVIDIA variant, or octarine-os-dx-gx when the base is the dx image (same layer, same packages)
ARG GX_IMAGE_ID=octarine-os-gx

# The pinned bins-gx image through a bind mount at /binaries (its package lists, then its zero components), in gx.sh (which also keeps the kernel unchanged)
RUN --mount=type=bind,from=binsgx,source=/,target=/binaries \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    /ctx/gx.sh

RUN --network=none bootc container lint --fatal-warnings --no-truncate
