# The pinned container images of the opt-in datastore Quadlets (datastore pod: PostgreSQL, Valkey, SeaweedFS; kafka pod: Kafka).
# ONE place for every tag and digest: variants/dx/datastore/render.sh renders the Quadlets of the image from this file at build
# time, so no tag is copied by hand into five files. KEY=VALUE lines, `#` comments, parsed (never sourced).
#   <NAME>_IMAGE   registry path without tag
#   <NAME>_TAG     the exact tag at patch level (never latest, never a floating major tag); a human label next to the digest
#   <NAME>_DIGEST  sha256 of the manifest (`skopeo inspect --raw docker://<image>:<tag> | sha256sum`); the Quadlet says <tag>@<digest>
#   <NAME>_MAJOR   the major version line this pin stays in: the weekly bump proposes newer tags only within it and only REPORTS a
#                  newer major ("newer major available, manual decision"); a database major needs dump and restore
# Majors are never bumped automatically. A user can override one image without touching /usr: `ujust datastore-setup --pin
# <service>=<tag>` writes a Quadlet drop-in in ~/.config/containers/systemd/.
POSTGRESQL_IMAGE=docker.io/library/postgres
POSTGRESQL_TAG=17.12-alpine
POSTGRESQL_DIGEST=sha256:34261f594522cf41dfcb76aefd42b9d201098b0e6b23c9c68733f169e4218b6f
POSTGRESQL_MAJOR=17
VALKEY_IMAGE=docker.io/valkey/valkey
VALKEY_TAG=9.1.3-alpine
VALKEY_DIGEST=sha256:bf09d58e96d6b4524a15396b65b242bbe18beebbcc15a04d8ee75ddac62fae0b
VALKEY_MAJOR=9
SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs
SEAWEEDFS_TAG=3.99
SEAWEEDFS_DIGEST=sha256:8d5b323911a996d5ea152115306bed468d9a849d72bcbb3800ea8d91b7728563
SEAWEEDFS_MAJOR=3
KAFKA_IMAGE=docker.io/apache/kafka
KAFKA_TAG=4.3.2
KAFKA_DIGEST=sha256:852a0d49fc4e656b022e7f23785411802c9a088c78a7c5e39f33969de9c227a7
KAFKA_MAJOR=4
