# The developer image of octarineOS (published as octarine-os-dx, see CLAUDE.md "dx image"): the published default
# image plus the developer toolchain of the owner's dev-toolbox. The latest channel follows the lineage
#   silverblue-main:45   -> octarine-os:latest -> octarine-os-dx:latest
# The workflow resolves the base by DIGEST (and verifies its signature) and passes it in, so the build, the labels and the
# size and kernel checks all talk about the same base:
#   BASE_IMAGE   ghcr.io/redcodeworks/octarine-os (the NVIDIA developer image, octarine-os-nvidia-dx, passes ghcr.io/redcodeworks/octarine-os-nvidia)
#   BASE_TAG     latest (only names the channel in the labels; the digest decides)
#   BASE_DIGEST  sha256:... of that tag when the build started (empty only for a bare local `podman build`)
ARG BASE_IMAGE=ghcr.io/redcodeworks/octarine-os
ARG BASE_TAG=latest
ARG BASE_DIGEST=

# The dx binaries image, ghcr.io/redcodeworks/octarine-bins-dx: a signed FROM scratch image built by the octarine-bins repository (with its OWN key,
# keys/octarine-bins.pub). It carries the developer package lists and their installer under /packages (required-fedora.txt, optional-fedora.txt, install.sh) and, so far,
# no binary component (/COMPONENTS is empty). PINNED by digest, like octarine-bins in the default Containerfile: BINS_DX_DIGEST changes only through the weekly bump pull
# request (bump-run.sh, kind bins-dx), the dx build verifies the pinned digest on every build (dx-image.yml) and records it in the bins-dx label. BINS_DX_TAG is only
# for humans. The pin covers the lists and the installer; the packages themselves still float through dnf.
ARG BINS_DX_TAG=20261117-5d8004e
ARG BINS_DX_DIGEST=sha256:4ca94a16301ffb928aa8ee68191aaec49a47f5a60e59c1694a30a91003afa8ec
ARG BINS_DX_REF=ghcr.io/redcodeworks/octarine-bins-dx:${BINS_DX_TAG}@${BINS_DX_DIGEST}

FROM ${BINS_DX_REF} AS binsdx
# (the ARGs above sit before the first FROM: only ARGs declared there are visible in a FROM line)

FROM scratch AS ctx
COPY variants/dx/dx.sh /dx.sh
COPY build_files/final-cleanup.sh /final-cleanup.sh
COPY build_files/install-binaries.sh /install-binaries.sh
COPY build_files/validate-repos.sh /validate-repos.sh
COPY variants/dx/system_files /system_files
COPY keys/redcodeworks-toolbox-cosign.pub /toolbox-cosign.pub

FROM ${BASE_IMAGE}:${BASE_TAG}${BASE_DIGEST:+@}${BASE_DIGEST}

# os-release IMAGE_VERSION of this build (set by the workflow), written by dx.sh
ARG IMAGE_VERSION
# os-release IMAGE_ID: octarine-os-dx, or octarine-os-nvidia-dx when the base is the NVIDIA variant (same layer, same packages)
ARG DX_IMAGE_ID=octarine-os-dx

# The pinned bins-dx image through a bind mount at /binaries (its package lists, then its zero components), in dx.sh (which also keeps the kernel unchanged)
RUN --mount=type=bind,from=binsdx,source=/,target=/binaries \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    /ctx/dx.sh

RUN --network=none bootc container lint --fatal-warnings --no-truncate
