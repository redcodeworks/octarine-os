# The pinned upstream release. The build fails unless the tag resolves to exactly this commit (an annotated tag: the
# commit it points at). The weekly workflow upstream-check.yml opens a bump PR on the branch bump/scx into testing when upstream has a newer release.
UPSTREAM_REPO=sched-ext/scx
UPSTREAM_TAG=v1.1.4
UPSTREAM_COMMIT=e7b3a219617472cf78880ac424714e52c932db61
