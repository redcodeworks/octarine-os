# Built from OUR FORK, pinned by commit: the fork is a plain mirror of the upstream project with no patches today; it exists
# for control over the build input (we pin the fork's commit, upstream cannot change it under us). UPSTREAM_WATCH is the real
# project the weekly check follows for new releases. The pinned commit is one after the last release (1.0.3; it only bumps
# the version to 1.0.4), so UPSTREAM_TAG stays empty; after a bump it is a display label only (a fork sync does not always
# bring tags), the pin is the commit.
UPSTREAM_REPO=redcodeworks/extest
UPSTREAM_WATCH=Supreeeme/extest
UPSTREAM_TAG=
UPSTREAM_COMMIT=cb77cd4f80f83393a24bae17dd975e14fa6eb1b2
