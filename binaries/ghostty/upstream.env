# Ghostty (terminal emulator, MIT), built from the upstream git tag. The pin is the tag AND its peeled commit: fetch-source.sh fails unless
# the tag still resolves to exactly this commit. Only stable v<major>.<minor>.<patch> tags (no tip, no vt-* library tags, no pre-releases) are bumped; the weekly check
# (upstream-check.yml, .github/scripts/ghostty-check.sh) also moves zig.env in the same pull request, because the Zig MINOR follows from the Ghostty tag.
UPSTREAM_REPO=ghostty-org/ghostty
UPSTREAM_TAG=v1.4.0
UPSTREAM_COMMIT=83fb95624b0439ee660c2679b43b38c8b63769cd
