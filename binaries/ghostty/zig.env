# The Zig toolchain of the Ghostty build: an official upstream tarball pinned by URL and sha256 (Fedora packages only zig 0.16, Ghostty 1.4.0 needs
# 0.17: build.zig.zon .minimum_zig_version = "0.17.0"; Ghostty's build accepts the same major.minor with any patch >= the minimum). Parsed, never sourced.
# fetch-zig.sh checks size and sha256, compares the sha256 with ziglang.org/download/index.json at build time, and verifies the minisign signature when
# `minisign` is installed (the Containerfile installs it). A mismatch fails the Ghostty component build, which then degrades (it is optional).
# Moved by the weekly check (the Zig minor follows from the Ghostty tag; a newer patch of the pinned minor is a separate low-priority pull request).
ZIG_VERSION=0.17.1
ZIG_URL=https://ziglang.org/download/0.17.1/zig-x86_64-linux-0.17.1.tar.xz
ZIG_SHA256=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a
ZIG_SIZE=57411036
ZIG_SIGNATURE_URL=https://ziglang.org/download/0.17.1/zig-x86_64-linux-0.17.1.tar.xz.minisig
ZIG_MINISIGN_KEY=RWSGOq2NVecA2UPNdBUZykf1CCb147pkmdtYxgb3Ti+JO/wCYvhbAb/U
