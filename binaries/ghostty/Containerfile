# Component ghostty of the prebuilt binaries (the Ghostty terminal emulator, OPTIONAL: it may be left out of the image, it never blocks an
# image build): published as ghcr.io/redcodeworks/octarine-os-binaries:c-ghostty-<key>, a FROM scratch image that holds only /ghostty
# (root/usr/..., FILES, LICENSES/, SOURCE, BUILDINFO). Build context: binaries/. Built from the git tag pinned in ghostty/upstream.env (tag and
# peeled commit, fetch-source.sh fails if the tag moved) with the Zig tarball pinned in ghostty/zig.env (ghostty/fetch-zig.sh: size, sha256,
# ziglang.org index.json and the minisign signature are checked). The builder is the Fedora 45 image of builder.env; CI passes it as --build-arg BUILDER.
ARG BUILDER

FROM ${BUILDER} AS build

# Build dependencies from Fedora's repositories (verified to exist in Fedora 45: gtk4 4.24, libadwaita 1.10, gtk4-layer-shell 1.3, blueprint-compiler 0.22).
# blueprint-compiler, gettext, pandoc, ncurses (tic) and libxml2 (xmllint) are what a git checkout needs beyond the source tarball.
RUN dnf5 -y install --setopt=install_weak_deps=False --setopt=strict=1 \
        git-core gcc gcc-c++ pkgconf-pkg-config curl jq tar xz minisign \
        gettext pandoc-cli blueprint-compiler libxml2 ncurses gobject-introspection \
        gtk4-devel libadwaita-devel gtk4-layer-shell-devel glib2-devel gobject-introspection-devel \
        mesa-libEGL-devel libGL-devel wayland-devel wayland-protocols-devel libX11-devel libxkbcommon-devel \
        harfbuzz-devel fontconfig-devel freetype-devel libpng-devel zlib-ng-compat-devel bzip2-devel expat-devel \
        oniguruma-devel simdutf-devel \
    && dnf5 clean all

COPY lib /binaries/lib
COPY ghostty /binaries/ghostty

# the pinned Zig, verified (fails the build on any mismatch), then the pinned source
RUN /binaries/ghostty/fetch-zig.sh /binaries/ghostty/zig.env /opt/zig
RUN /binaries/lib/fetch-source.sh /binaries/ghostty/upstream.env /src
RUN ZIG_DIR=/opt/zig STAGE_SH=/binaries/lib/stage.sh /binaries/ghostty/build.sh /binaries/ghostty/upstream.env /src /out

FROM scratch

# Build values passed by CI (podman build --build-arg ...); no secrets
ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown

COPY --from=build /out /ghostty

LABEL maintainer="redcodeworks/octarine-os" \
      org.opencontainers.image.authors="redcodeworks" \
      org.opencontainers.image.vendor="redcodeworks" \
      org.opencontainers.image.title="octarine-os-binaries (component ghostty)" \
      org.opencontainers.image.description="the Ghostty terminal emulator built from a pinned upstream tag with a pinned Zig" \
      org.opencontainers.image.url="https://github.com/redcodeworks/octarine-os" \
      org.opencontainers.image.source="https://github.com/redcodeworks/octarine-os" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}" \
      org.octarineos.binaries-component="ghostty"
