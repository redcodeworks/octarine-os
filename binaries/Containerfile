# The prebuilt binaries image, ONE multi-stage build (binaries.yml): scx, extest and ghostty are built in their own stages from the builder of
# builder.env (digest-pinned; CI and `podman build` pass it as --build-arg BUILDER), then the `assemble` stage puts them side by side and the final
# FROM scratch image holds /scx, /extest, /ghostty, a top-level LICENSES/, SOURCE, BUILDINFO and COMPONENTS (the names of components.tsv, one per
# line). Build context: this directory (binaries/): `podman build --build-arg BUILDER=... --file binaries/Containerfile binaries`. A failing stage
# fails the whole build: nothing is half built, nothing is published. Every component is required.
ARG BUILDER

# ---- scx
FROM ${BUILDER} AS scx

RUN dnf5 -y install --setopt=install_weak_deps=False --setopt=strict=1 \
        git-core rust cargo clang llvm lld libbpf-devel elfutils-libelf-devel zlib-devel libzstd-devel \
        pkgconf-pkg-config bpftool make gcc binutils \
    && dnf5 clean all

COPY lib /binaries/lib
COPY scx /binaries/scx

RUN /binaries/lib/fetch-source.sh /binaries/scx/upstream.env /src

# Every scheduler in scx/schedulers.tsv from the one tag in a single cargo invocation (cargo build --release --locked -p <each>);
# the BPF side is compiled by scx's build scripts with clang. build.sh then stages the binaries, licenses, SOURCE, BUILDINFO and
# the manifest and runs each binary's --version.
RUN STAGE_SH=/binaries/lib/stage.sh /binaries/scx/build.sh /binaries/scx/schedulers.tsv /binaries/scx/upstream.env /src /out

# ---- extest
FROM ${BUILDER} AS extest

RUN dnf5 -y install --setopt=install_weak_deps=False --setopt=strict=1 \
        git-core rust cargo gcc binutils \
        rust-std-static-i686-unknown-linux-gnu glibc-devel.i686 libgcc.i686 \
    && dnf5 clean all

COPY lib /binaries/lib
COPY extest /binaries/extest

RUN /binaries/lib/fetch-source.sh /binaries/extest/upstream.env /src
RUN STAGE_SH=/binaries/lib/stage.sh /binaries/extest/build.sh /binaries/extest/upstream.env /src /out

# ---- ghostty
FROM ${BUILDER} AS ghostty

# Build dependencies from Fedora's repositories (verified to exist in Fedora 45: gtk4 4.24, libadwaita 1.10, gtk4-layer-shell 1.3, blueprint-compiler 0.22).
# blueprint-compiler, gettext, pandoc, ncurses (tic) and libxml2 (xmllint) are what a git checkout needs beyond the source tarball.
RUN dnf5 -y install --setopt=install_weak_deps=False --setopt=strict=1 \
        git-core gcc gcc-c++ pkgconf-pkg-config curl jq tar xz minisign \
        gettext pandoc-cli blueprint-compiler libxml2 ncurses gobject-introspection \
        gtk4-devel libadwaita-devel gtk4-layer-shell-devel glib2-devel gobject-introspection-devel \
        mesa-libEGL-devel libGL-devel wayland-devel wayland-protocols-devel libX11-devel libxkbcommon-devel \
        harfbuzz-devel fontconfig-devel freetype-devel libpng-devel zlib-ng-compat-devel bzip2-devel expat-devel \
        oniguruma-devel simdutf-devel \
    && dnf5 clean all

COPY lib /binaries/lib
COPY ghostty /binaries/ghostty

# the pinned Zig, verified (fails the build on any mismatch), then the pinned source
RUN /binaries/ghostty/fetch-zig.sh /binaries/ghostty/zig.env /opt/zig
RUN /binaries/lib/fetch-source.sh /binaries/ghostty/upstream.env /src
RUN ZIG_DIR=/opt/zig STAGE_SH=/binaries/lib/stage.sh /binaries/ghostty/build.sh /binaries/ghostty/upstream.env /src /out

# ---- assemble: one directory per component, the union of licenses, the combined SOURCE and BUILDINFO, the COMPONENTS list
FROM ${BUILDER} AS assemble
COPY --from=scx /out /out/scx
COPY --from=extest /out /out/extest
COPY --from=ghostty /out /out/ghostty
COPY components.tsv lib/assemble.sh /
RUN /assemble.sh /out /components.tsv

FROM scratch

# Build values passed by CI (podman build --build-arg ...); no secrets
ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown

COPY --from=assemble /out /

LABEL maintainer="redcodeworks/octarine-os" \
      org.opencontainers.image.authors="redcodeworks" \
      org.opencontainers.image.vendor="redcodeworks" \
      org.opencontainers.image.title="octarine-binaries" \
      org.opencontainers.image.description="Prebuilt binaries for octarineOS (sched_ext schedulers, libextest.so, ghostty), built in one multi-stage build" \
      org.opencontainers.image.url="https://github.com/redcodeworks/octarine-os" \
      org.opencontainers.image.source="https://github.com/redcodeworks/octarine-os" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
