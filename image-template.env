# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=octarine-os

# Make this the same as your github username/organisation
REPO_ORGANIZATION="redcodeworks"

IMAGE_DESC="A Fedora Silverblue based bootc image with the niri compositor, Noctalia shell, Cockpit and a curated desktop setup"
IMAGE_KEYWORDS="bootc,oci,linux,fedora,silverblue,niri,gnome"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest@sha256:4d8a0d9d173a9f450ff42d70777e1e0a6681a68f5c0f5084b65222eceb1f4d05"
